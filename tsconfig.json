{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strictBindCallApply": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["main.js", "lib/**/*.js"],
  "exclude": ["node_modules", "dist", ".artifacts", ".local"]
}
