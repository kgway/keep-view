{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": ["main.js", "lib/**/*.js"],
  "exclude": ["node_modules", "dist", ".artifacts", ".local"]
}
